# ─────────────────────────────────────────────────────────────────────────────
# server1 (Next.js) — auth, history pages, Supabase reads.
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# On Vercel these go in Settings → Environment Variables instead.
# `.env.local` is git-ignored and never reaches the deployment.
# ─────────────────────────────────────────────────────────────────────────────

# --- server2 (FastAPI on EC2) -----------------------------------------------
# Read by app/lib/api.ts, so the name must be exactly this. Include the scheme,
# no trailing slash.
#
# The scheme matters: an https:// page cannot open ws:// or http:// (mixed
# content), so in production this has to be a TLS endpoint — a Cloudflare
# Tunnel in front of the EC2 box is the quickest route. Note that a quick
# tunnel's URL changes every time cloudflared restarts.
NEXT_PUBLIC_SERVER2_URL=http://localhost:8000

# --- Supabase ----------------------------------------------------------------
# The frontend only READS: `devices` to resolve email → device uuid at login,
# and `recordings` for the history lists. All writes belong to server2.
# Reads happen in route handlers — the browser never talks to Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# --- Bridge to server2 -------------------------------------------------------
# Same value as JWT_SHARED_SECRET in server/.env. Signs the 15-minute HS256
# token the browser carries to server2 (/ws?token=… and Bearer headers).
JWT_SHARED_SECRET=

# --- Auth.js v5 (next-auth) --------------------------------------------------
# Signs/encrypts the session cookie (session.strategy = "jwt"). Without it,
# Auth.js refuses to start with `MissingSecret`.
# Independent of JWT_SHARED_SECRET: that one talks to server2, this one is
# purely the browser's own cookie. Changing it invalidates open sessions.
#   openssl rand -base64 32
AUTH_SECRET=

# --- Google OAuth ------------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID,
# type "Web application". Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google        (local)
#   https://<your-domain>/api/auth/callback/google        (production)
#
# Sign-in is gated on top of this: auth.ts rejects any email without a row in
# `devices`, so a valid Google account alone is not enough to get in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
