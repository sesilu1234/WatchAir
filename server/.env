# server2 (FastAPI en la EC2) — capa de tiempo real. No toca Supabase directamente:
# todo el acceso a Postgres/Storage vive en el frontend (server1).

# Compartido con server1 (Next.js): valida el JWT que manda el navegador
# (WS /ws?token=... y HTTP Authorization: Bearer <token>).
JWT_SHARED_SECRET=Onkd/qcNlrp/bo7I++oA5e1S0QifZN3E2rAU8glpibI=

# Compartido con el firmware ESP32: autentica el device por WS (junto a su
# DEVICE_UUID). Va en la query string de /device/ws, por eso es base64url
# (sin '+' ni '/'): el ESP32 no tiene a mano un url-encoder decente.
DEVICE_SECRET=So_X3eoADQEzmnKSVaXpPpA7CsDoxAsovBUk_utOAD4

# Compartido con server1: autentica las llamadas de server2 a
# /api/internal/* en el frontend (crear fila de grabación, subir binario).
INTERNAL_API_SECRET=0dwscoJUZwgAEGGapgY+SaIGB2oxYcVFdpmBFSK/x5I=

# Base URL del frontend, para las llamadas internas de arriba. server2 corre
# en la EC2 y no puede llegar a un localhost del portátil del usuario, así que
# mientras el frontend corra en local hace falta un túnel Cloudflare quick
# tunnel apuntando a http://localhost:3000 (cambia cada vez que se reinicia).
# TODO: actualizar esto a la URL de Vercel en cuanto el frontend esté desplegado ahí.
FRONTEND_URL=https://rainbow-indicate-quantities-naturally.trycloudflare.com
