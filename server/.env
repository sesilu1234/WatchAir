# server2 (FastAPI en la EC2) — capa de tiempo real. Es el UNICO que escribe en
# Supabase (Postgres + Storage). El frontend solo lee `devices` para resolver
# email -> uuid del aparato en el login.

# Compartido con server1 (Next.js): valida el JWT que manda el navegador
# (WS /ws?token=... y HTTP Authorization: Bearer <token>).
JWT_SHARED_SECRET=Onkd/qcNlrp/bo7I++oA5e1S0QifZN3E2rAU8glpibI=

# Compartido con el firmware ESP32: autentica el device por WS (junto a su
# DEVICE_UUID). Va en la query string de /device/ws, por eso es base64url
# (sin '+' ni '/'): el ESP32 no tiene a mano un url-encoder decente.
DEVICE_SECRET=So_X3eoADQEzmnKSVaXpPpA7CsDoxAsovBUk_utOAD4

# Supabase. La service role key bypassa RLS: nunca sale de la EC2.
