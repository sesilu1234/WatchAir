# server2 (FastAPI en la EC2) — capa de tiempo real. Es el UNICO que escribe en
# Supabase (Postgres + Storage). El frontend solo lee `devices` para resolver
# email -> uuid del aparato en el login.

# Compartido con server1 (Next.js): valida el JWT que manda el navegador
# (WS /ws?token=... y HTTP Authorization: Bearer <token>).
JWT_SHARED_SECRET=Onkd/qcNlrp/bo7I++oA5e1S0QifZN3E2rAU8glpibI=

# Un secreto por aparato, "uuid:secreto" separados por comas. Cada uno va
# hardcodeado en el firmware de SU ESP32 (esp32/include/secrets.h) y viaja en la
# query string de /device/ws, por eso es base64url (sin '+' ni '/'): el ESP32 no
# tiene a mano un url-encoder decente. Las claves son ademas la lista blanca de
# UUIDs: un uuid que no este aqui no se puede conectar.
#   8d257ddd… Ulises   ·  01bbe27b… Angela   ·  af87778a… Minerva
DEVICE_SECRETS=8d257ddd-79bc-4fc7-969c-8ba42d315b22:So_X3eoADQEzmnKSVaXpPpA7CsDoxAsovBUk_utOAD4,01bbe27b-7b83-4247-839e-0826b23f473c:MdVkaq9Ya6ANLEm1-DJa4gfEQRwBp71KIvj9g_1O6I8,af87778a-9e0c-4445-ad5e-62d78943272e:ZiTZskGAachvjMweXhXeBFi6HakDDbKk3xclxtnPrZA

# Supabase. La service role key bypassa RLS: nunca sale de la EC2.
SUPABASE_URL=https://pgizvbymylpxeufikiyb.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBnaXp2YnlteWxweGV1ZmlraXliIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTU5MzgzNCwiZXhwIjoyMTAxMTY5ODM0fQ.3VnymOtb7l9GAtQbQMubPvWRhvbExNLeLOKMekdl7DI
