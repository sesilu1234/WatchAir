# ─────────────────────────────────────────────────────────────────────────────
# server2 (FastAPI on EC2) — the real-time layer.
#
# Copy to `.env` and fill in. Every variable here is REQUIRED: app/config.py
# fails fast at import time rather than blowing up mid-request.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Shared with server1 (Next.js). Validates the short-lived JWT the browser
# presents on `WS /ws?token=…` and `Authorization: Bearer …`.
# Must be byte-identical to JWT_SHARED_SECRET in frontend/.env.local.
#   openssl rand -base64 32
JWT_SHARED_SECRET=

# One secret per device: "uuid:secret,uuid:secret". Each pair is hardcoded in
# THAT board's firmware (esp32/include/secrets.h) and travels in the query
# string of /device/ws — so use base64url (no '+', no '/'): the ESP32 has no
# decent URL-encoder on hand.
#
# The keys double as the UUID whitelist: a uuid that isn't listed here cannot
# connect at all.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DEVICE_SECRETS=

# Supabase. The service role key bypasses RLS — it must never leave this box,
# and in particular must never reach the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
